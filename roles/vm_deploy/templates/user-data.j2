#cloud-config
# Generated by satellite-demo-automation.
# Skupper token valid for {{ skupper_grant_expiration }} from playbook run time.

ssh_pwauth: true

write_files:
  - path: /etc/skupper/token.yaml
    permissions: '0600'
    owner: root:root
    content: |
      apiVersion: skupper.io/v2alpha1
      kind: AccessToken
      metadata:
        name: ground-station-link
      spec:
        url: {{ skupper_grant_url }}
        code: {{ skupper_grant_code }}
        ca: |
{{ skupper_grant_ca | trim | indent(10, first=True) }}
