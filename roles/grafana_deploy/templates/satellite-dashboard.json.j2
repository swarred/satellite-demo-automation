{
  "id": null,
  "uid": "satellite-edge",
  "title": "Satellite Edge Status",
  "tags": ["satellite", "edge", "flightctl"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Satellite Status",
      "description": "Fleet-level Online count from flightctl DeviceList summary.summaryStatus.Online.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "flightctl-ds" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "method": "GET",
          "url": "/api/v1/devices?labelSelector=role%3Dsatellite-sim"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": { "source": "summary", "format": "json", "replace": false, "keepTime": false }
        },
        {
          "id": "extractFields",
          "options": { "source": "summaryStatus", "format": "json", "replace": false, "keepTime": false }
        },
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["Online"] } }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "ONLINE",  "color": "green", "index": 0 },
                "0": { "text": "OFFLINE", "color": "red",   "index": 1 }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": { "text": "OFFLINE", "color": "red", "index": 2 }
              }
            }
          ],
          "noValue": "OFFLINE"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Satellite AOI — {{ grafana_satellite_label }}",
      "description": "Satellite position over area of interest. Marker turns red when link is lost (DDIL).",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "flightctl-ds" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "method": "GET",
          "url": "/api/v1/devices?labelSelector=role%3Dsatellite-sim"
        },
        {
          "refId": "B",
          "type": "json",
          "source": "inline",
          "format": "table",
          "data": "[{\"lat\": {{ grafana_satellite_lat }}, \"lon\": {{ grafana_satellite_lon }}}]"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": { "source": "summary", "format": "json", "replace": false, "keepTime": false }
        },
        {
          "id": "extractFields",
          "options": { "source": "summaryStatus", "format": "json", "replace": false, "keepTime": false }
        },
        { "id": "merge", "options": {} },
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["lat", "lon", "Online"] } }
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": {{ grafana_satellite_lat }},
          "lon": {{ grafana_satellite_lon }},
          "zoom": 5
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false
        },
        "basemap": { "type": "default", "name": "Basemap" },
        "layers": [
          {
            "type": "markers",
            "name": "Satellite Sim",
            "config": {
              "size":        { "fixed": 20, "min": 2, "max": 40, "field": "" },
              "color":       { "field": "Online", "fixed": "green" },
              "symbol":      { "fixed": "img/icons/marker/circle.svg", "mode": "fixed" },
              "fillOpacity": 0.8,
              "showLegend":  true
            },
            "location": {
              "mode": "coords",
              "latitudeField": "lat",
              "longitudeField": "lon"
            },
            "tooltip": true
          }
        ],
        "tooltip": { "mode": "details" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
