{
  "id": null,
  "uid": "satellite-edge",
  "title": "Satellite Edge Status",
  "tags": ["satellite", "edge", "flightctl"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Satellite Status",
      "description": "Live device status — reads summary string from flightctl DeviceList and regex-matches Online count.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "flightctl-ds" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "method": "GET",
          "url": "/api/v1/devices?labelSelector=role%3Dsatellite-sim"
        }
      ],
      "transformations": [],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^summary$/",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "\"Online\":[1-9]",
                "result": { "text": "ONLINE", "color": "green", "index": 0 }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": { "text": "OFFLINE", "color": "red", "index": 1 }
              }
            }
          ],
          "noValue": "OFFLINE"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Satellite AOI — {{ grafana_satellite_label }}",
      "description": "Fixed AOI marker. Satellite Status panel above shows live link state.",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "flightctl-ds" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "inline",
          "format": "table",
          "data": "[{\"lat\": {{ grafana_satellite_lat }}, \"lon\": {{ grafana_satellite_lon }}}]"
        }
      ],
      "transformations": [],
      "options": {
        "view": {
          "id": "coords",
          "lat": {{ grafana_satellite_lat }},
          "lon": {{ grafana_satellite_lon }},
          "zoom": 5
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false
        },
        "basemap": { "type": "default", "name": "Basemap" },
        "layers": [
          {
            "type": "markers",
            "name": "Satellite Sim",
            "config": {
              "size":        { "fixed": 20, "min": 2, "max": 40, "field": "" },
              "color":       { "fixed": "green" },
              "symbol":      { "fixed": "img/icons/marker/circle.svg", "mode": "fixed" },
              "fillOpacity": 0.8,
              "showLegend":  true
            },
            "location": {
              "mode": "coords",
              "latitudeField": "lat",
              "longitudeField": "lon"
            },
            "tooltip": true
          }
        ],
        "tooltip": { "mode": "details" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      }
    }
  ]
}
