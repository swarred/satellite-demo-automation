        "content": "<div id='sat-status' style='display:flex;align-items:center;justify-content:center;height:100%;font-family:sans-serif'><span style='font-size:3em;font-weight:bold;color:#888'>Loading...</span></div><script>(function(){\n  var url='https://{{ _gs_route_host.stdout | trim }}/grafana/status';\n  var OID='sat-offline-overlay';\n  function getOverlay(){\n    var o=document.getElementById(OID);\n    if(o) return o;\n    var mp=document.querySelector('[data-panelid=\"2\"]');\n    if(!mp) return null;\n    var ct=mp.querySelector('[class*=\"panel-content\"]');\n    if(!ct) return null;\n    ct.style.position='relative';\n    o=document.createElement('div');\n    o.id=OID;\n    o.style.cssText='position:absolute;inset:0;background:rgba(200,30,30,0.22);z-index:1000;pointer-events:none;display:none;align-items:center;justify-content:center;flex-direction:column;gap:10px;';\n    o.innerHTML='<div style=\"font-family:monospace;font-size:2.8em;font-weight:bold;color:#ff4d4f;letter-spacing:5px;text-shadow:0 0 30px rgba(255,50,50,0.9);animation:lsp 1.5s ease-in-out infinite\">LINK SEVERED</div><div style=\"font-family:monospace;font-size:1.1em;color:#ff9999;letter-spacing:3px\">AUTONOMOUS OPS ACTIVE</div><style>@keyframes lsp{0%,100%{opacity:1}50%{opacity:0.4}}</style>';\n    ct.appendChild(o);\n    return o;\n  }\n  function update(){\n    fetch(url).then(function(r){return r.json()}).then(function(d){\n      var online=d[0]&&d[0].online===1;\n      var el=document.getElementById('sat-status');\n      if(el){el.style.background=online?'#1a5c2a':'#6b0f1a';el.innerHTML='<span style=\"font-size:4em;font-weight:bold;color:'+(online?'#52c41a':'#ff4d4f')+'\">'+(online?'ONLINE':'OFFLINE')+'</span>';}\n      var ov=getOverlay();\n      if(ov) ov.style.display=online?'none':'flex';\n    }).catch(function(){});\n  }\n  update();setInterval(update,5000);\n})();</script>"
      }
